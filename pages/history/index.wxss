.history { padding-top: 20rpx; padding-bottom: env(safe-area-inset-bottom); }
.history-row { width: 100%; display: flex; align-items: center; gap: 25rpx; padding: 22rpx 0; border-bottom: 1px solid var(--line); text-align: left; }
.history-photo { width: 175rpx; height: 165rpx; flex-shrink: 0; border-radius: 19rpx; }
.history-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.history-title { font-size: 35rpx; overflow-wrap: anywhere; }
.history-meta { font-size: 27rpx; color: var(--muted); }
