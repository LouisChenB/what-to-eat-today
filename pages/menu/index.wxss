.menu-cover { position: relative; min-height: 275rpx; background: var(--rail); }
.menu-cover-image { position: absolute; width: 100%; height: 100%; }
.menu-copy { position: relative; padding: 52rpx 32rpx 36rpx; width: 63%; }
.menu-date { font-size: 31rpx; }
.menu-title-line { display: flex; align-items: center; gap: 6rpx; margin-top: 12rpx; }
.menu-heading { min-width: 0; line-height: 1.1; font-size: 96rpx; overflow-wrap: anywhere; }
.menu-heading--custom { font-size: 49rpx; line-height: 1.2; }
.edit-button { width: 44px; height: 44px; display: flex; justify-content: center; align-items: center; flex-shrink: 0; }
.edit-button image { width: 42rpx; height: 42rpx; }
.menu-groups { padding-top: 36rpx; padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.menu-group + .menu-group { margin-top: 36rpx; }
.group-label { display: flex; gap: 22rpx; align-items: center; font-size: 43rpx; margin-bottom: 12rpx; }
.group-label::after { content: ''; height: 1px; background: var(--line); flex: 1; }
.menu-actions .button { flex: 1; white-space: nowrap; }
.menu-actions .button--primary { flex: 1.12; }
.share-icon { width: 34rpx; height: 34rpx; }
.title-input { box-sizing: border-box; width: 100%; min-height: 44px; border-radius: 16rpx; border: 1px solid var(--line); background: var(--surface); padding: 12rpx 20rpx; }
.editor-submit { width: 100%; margin-top: 24rpx; }
