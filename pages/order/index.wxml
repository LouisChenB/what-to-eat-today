<view class="order">
  <view class="cover" style="--header-inset: {{headerInset}}px">
    <image class="cover-image" src="/assets/brand/order-cover.jpg" mode="aspectFill" />
    <view class="cover-copy">
      <text class="cover-title display">一桌家常</text>
      <text class="cover-date display">{{dateLabel}}</text>
    </view>
  </view>

  <view class="catalogue">
    <view class="catalogue-header">
      <view class="catalogue-action random-button" role="button" bindtap="drawPair" hover-class="pressed">
        <image class="toolbar-icon" src="/assets/icons/shuffle.svg" mode="aspectFit" />
        <text>随机一荤一素</text>
      </view>
      <view class="catalogue-action history-button" role="button" bindtap="openHistory" hover-class="pressed">
        <image class="toolbar-icon" src="/assets/icons/history.svg" mode="aspectFit" />
        <text>历史菜单</text>
      </view>
      <view class="catalogue-action import-button" role="button" bindtap="openMenuImporter" hover-class="pressed">
        <text>导入菜单</text>
      </view>
    </view>
    <view class="catalogue-body">
      <view class="category-shortcuts">
        <button
          wx:for="{{categories}}" wx:key="id"
          class="control category-shortcut display {{activeCategory === item.id ? 'category-shortcut--active' : ''}}"
          data-id="{{item.id}}" bindtap="jumpToCategory" hover-class="pressed"
          aria-label="{{categoryLabels[item.id]}}{{activeCategory === item.id ? '，当前分类' : ''}}"
        >{{categoryLabels[item.id]}}</button>
      </view>
      <scroll-view class="dish-scroll" scroll-y scroll-into-view="{{scrollTarget}}" bindscroll="handleDishScroll">
        <view class="dish-list">
          <block wx:for="{{dishList}}" wx:key="id">
            <view
              wx:if="{{index === 0 || item.category !== dishList[index - 1].category}}"
              id="category-{{item.category}}" class="catalogue-category display"
            >{{categoryLabels[item.category]}}</view>
            <dish-row dish="{{item}}" selectable selected="{{item.selected}}" bind:selection="toggleDish" />
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="action-bar order-actions">
    <view class="selected-count display" role="button" bindtap="openSelection" hover-class="pressed" aria-label="查看已选的 {{count}} 道菜">
      <text>已选 {{count}} 道</text>
      <view class="arrow selected-arrow"></view>
    </view>
    <button class="button button--primary order-submit {{count ? '' : 'button--disabled'}}" aria-disabled="{{!count}}" bindtap="openMenu" hover-class="pressed">
      <text>查看菜单</text><image class="submit-arrow" src="/assets/icons/forward.svg" mode="aspectFit" />
    </button>
  </view>
</view>

<view wx:if="{{showingSelection}}" class="overlay" bindtap="closeSelection">
  <view class="sheet selection-sheet" catchtap="keepSheetOpen">
    <view class="sheet-header display">
      <text>已选 {{count}} 道菜</text>
      <button class="control sheet-close" aria-label="关闭已选菜品" bindtap="closeSelection">×</button>
    </view>
    <scroll-view wx:if="{{count}}" class="selection-list" style="--selection-height: {{count * 104 + selectedGroups.length * 66}}rpx" scroll-y>
      <view wx:for="{{selectedGroups}}" wx:key="id" wx:for-item="group" class="selection-group">
        <view class="selection-category">{{group.name}}</view>
        <dish-row wx:for="{{group.dishes}}" wx:key="id" dish="{{item}}" compact />
      </view>
    </scroll-view>
    <view wx:else class="selection-empty">还没有选菜</view>
  </view>
</view>

<view wx:elif="{{pair.length}}" class="overlay" bindtap="closePair" catchtouchmove="keepSheetOpen">
  <view class="sheet" catchtap="keepSheetOpen">
    <view class="sheet-header display">
      <text>随机一荤一素</text>
      <button class="control sheet-close" aria-label="关闭随机选菜" bindtap="closePair">×</button>
    </view>
    <view class="pair">
      <view wx:for="{{pair}}" wx:key="id" class="pair-dish">
        <image class="pair-photo" src="{{item.photo}}" mode="aspectFill" />
        <text class="pair-name display">{{item.name}}</text>
        <text class="pair-category">{{item.category === 'meat' ? '荤菜' : '蔬菜'}}</text>
      </view>
    </view>
    <view class="pair-actions">
      <button class="button button--outline {{canReroll ? '' : 'button--disabled'}}" bindtap="rerollPair" aria-disabled="{{!canReroll}}" hover-class="pressed">换一组</button>
      <button class="button button--primary" bindtap="addPair" hover-class="pressed">加入菜单</button>
    </view>
  </view>
</view>

<view wx:elif="{{showingMenuImporter}}" class="overlay" bindtap="closeMenuImporter">
  <view class="sheet" catchtap="keepSheetOpen">
    <view class="sheet-header display">
      <text>导入菜单</text>
      <button class="control sheet-close" aria-label="关闭导入菜单" bindtap="closeMenuImporter">×</button>
    </view>
    <form bindsubmit="importMenu">
      <textarea class="import-code" name="code" placeholder="粘贴好友发来的分享码" maxlength="{{-1}}"
        fixed="{{true}}" cursor-spacing="24" bindinput="clearImportError" aria-label="菜单分享码" />
      <text wx:if="{{importError}}" class="import-error">{{importError}}</text>
      <view class="import-actions">
        <button class="button button--outline" bindtap="importClipboardMenu" hover-class="pressed">从剪贴板查看</button>
        <button class="button button--primary" form-type="submit" hover-class="pressed">查看菜单</button>
      </view>
    </form>
  </view>
</view>
