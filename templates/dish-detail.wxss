.detail { padding: 24rpx 24rpx calc(44rpx + env(safe-area-inset-bottom)); }
.dish-heading { display: flex; align-items: baseline; gap: 24rpx; margin: 0 8rpx 22rpx; }
.detail-title { font-size: 64rpx; line-height: 1.18; }
.detail-category { flex-shrink: 0; color: var(--muted); font-size: 29rpx; }
.detail-photo { width: 100%; height: 526rpx; border-radius: 24rpx; background: var(--rail); }
.recipe-section { margin-top: 43rpx; }
.recipe-title { display: block; margin: 0 8rpx 26rpx; font-size: 49rpx; line-height: 1.2; }
.recipe-pages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.recipe-pages--single { grid-template-columns: minmax(0, 1fr); }
.recipe-page { border-radius: 23rpx; background: #fff9e4; overflow: hidden; }
.recipe-thumbnail { width: 100%; background: var(--surface); }
.recipe-caption { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 13rpx 18rpx; min-height: 34px; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 23rpx 23rpx; color: var(--muted); font-size: 27rpx; }
.expand-icon { width: 28rpx; height: 28rpx; flex: none; }
.recipe-placeholder { width: calc(100% - 16rpx); height: 94rpx; margin: 0 8rpx 9rpx; border-radius: 16rpx; background: #dcdddb; }
.recipe-steps { margin: 0 8rpx; }
.recipe-step { display: flex; align-items: baseline; gap: 15rpx; padding: 26rpx 0; line-height: 1.63; }
.recipe-step + .recipe-step { border-top: 1px solid var(--line); }
.step-number { color: var(--muted); font-weight: 700; flex: none; }
.step-copy { min-width: 0; }
