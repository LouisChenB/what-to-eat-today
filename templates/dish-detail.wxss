.detail { padding: 24rpx 24rpx calc(44rpx + env(safe-area-inset-bottom)); }
.dish-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin: 0 0 22rpx 8rpx; }
.detail-title { min-width: 0; overflow-wrap: anywhere; font-size: 64rpx; line-height: 1.18; }
.detail-category { flex: none; padding: 6rpx 18rpx; border-radius: 999rpx; background: var(--category-label); font-size: 26rpx; }
.detail-photo { width: 100%; height: 526rpx; border-radius: 24rpx; background: var(--rail); }
.recipe-section { margin-top: 43rpx; }
.recipe-title { display: block; margin: 0 8rpx 26rpx; font-size: 49rpx; line-height: 1.2; }
.recipe-pages { display: flex; flex-direction: column; gap: 18rpx; }
.recipe-page { border-radius: 23rpx; overflow: hidden; }
.recipe-thumbnail { width: 100%; background: var(--surface); }
.recipe-placeholder { width: calc(100% - 16rpx); height: 94rpx; margin: 0 8rpx 9rpx; border-radius: 16rpx; background: #dcdddb; }
.recipe-steps { margin: 0 8rpx; }
.recipe-step { display: flex; align-items: baseline; gap: 15rpx; padding: 26rpx 0; line-height: 1.63; }
.recipe-step + .recipe-step { border-top: 1px solid var(--line); }
.step-number { color: var(--muted); font-weight: 700; flex: none; }
.step-copy { min-width: 0; }
